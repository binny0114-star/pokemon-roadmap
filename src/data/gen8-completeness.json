  "families": {
    "letsgo7": {
      "games": ["lets-go-pikachu", "lets-go-eevee"],
      "requiredSourceCategories": ["wild", "overworld", "static", "gift", "trade", "catch-combo", "secret-techniques", "level-up", "tm", "tutor", "reminder", "evolution", "story"],
      "gates": {
        "availability": {
          "requirements": [
            {
              "id": "wild-static-gift-trade",
              "status": "blocked",
              "sourceRefs": ["pkhex", "pokeapi"],
              "evidence": "PKHeX exposes separate GP/GE wild tables plus static, gift and in-game trade tables with species, form, level and location, but no normalized catch-combo spawn modifier or planner chapter key.",
              "missingFields": ["catch-combo-state", "lure-state", "sky-spawn-gate", "planner-chapter"],
              "attemptedAlternatives": ["PokéAPI version 31/32 encounters", "PKHeX Encounters7GG and encounter resources"]
            }
          ]
        },
        "forms": {
          "requirements": [
            {
              "id": "partner-and-alolan-forms",
              "status": "blocked",
              "sourceRefs": ["pkhex"],
              "evidence": "PKHeX preserves partner Pikachu form 8, partner Eevee form 1 and Alolan trade forms, while the application species runtime remains default-form-only.",
              "missingFields": ["runtime-form-types", "runtime-form-stats", "form-aware-party-identity"],
              "attemptedAlternatives": ["PokéAPI pokemon forms", "PKHeX personal_gg"]
            }
          ]
        },
        "learnsets": {
          "requirements": [
            {
              "id": "level-tm-tutor-reminder",
              "status": "blocked",
              "sourceRefs": ["pkhex", "pokeapi"],
              "evidence": "PKHeX LearnSource7GG identifies level-up, 60 TM moves, partner tutors and the all-level move-reminder rule with no HMs; neither pinned source supplies exact TM and partner-tutor acquisition chapters.",
              "missingFields": ["tm-acquisition-chapter", "partner-tutor-acquisition-chapter", "resource-reusability-timing"],
              "attemptedAlternatives": ["PokéAPI version group 19 move rows", "PKHeX LearnSource7GG and lvlmove_gg"]
            }
          ]
        },
        "evolutions": {
          "requirements": [
            {
              "id": "letsgo-evolution-reachability",
              "status": "blocked",
              "sourceRefs": ["pkhex", "pokeapi"],
              "evidence": "Pinned evolution tables provide conditions but not the earliest item, friendship, trade-alternative or location reachability in the Let's Go story.",
              "missingFields": ["evolution-item-chapter", "friendship-earliest-chapter", "trade-alternative", "regional-form-evolution-context"],
              "attemptedAlternatives": ["PokéAPI evolution chains", "PKHeX evos_gg"]
            }
          ]
        },
        "story": {
          "requirements": [
            {
              "id": "mandatory-chronology",
              "status": "blocked",
              "sourceRefs": ["bulbapedia"],
              "evidence": "The Korean preview enumerates the eight gyms, Silph Co., Viridian Gym, Elite Four and rival champion endpoint, but does not yet encode every mandatory rival and Team Rocket battle or route warning as boss actions.",
              "missingFields": ["mandatory-rival-battles", "mandatory-team-rocket-battles", "story-warnings"],
              "attemptedAlternatives": ["Bulbapedia LGPE walkthrough revision 4247959", "PKHeX Encounters7GG"]
            }
          ]
        },
        "mechanics": {
          "requirements": [
            {
              "id": "secret-techniques",
              "status": "complete",
              "sourceRefs": ["bulbapedia", "pkhex"],
              "evidence": "The preview models Chop Down, Light Up, Sky Dash, Strong Push and Sea Skim as partner Secret Techniques and does not create party HM slots."
            }
          ]
        },
        "integration": {
          "requirements": [
            {
              "id": "full-planner-contract",
              "status": "blocked",
              "sourceRefs": ["pokeapi", "pkhex"],
              "evidence": "The mechanics-aware catalog preview is integrated, but form-aware six-member planning and four-move timing cannot run while availability, forms, learnsets and evolutions are blocked.",
              "missingFields": ["form-aware-six-member-generation", "four-move-acquisition-timing", "planner-progress-contract"],
              "attemptedAlternatives": ["existing classic planner engine", "catalog preview integration"]
            }
          ]
        }
      }
    },
